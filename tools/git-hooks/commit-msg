#!/usr/bin/env bash
# Preserve the clone's existing native hook and tracked security hook behavior.
root="$(git rev-parse --show-toplevel)" || exit 1
common="$(git rev-parse --path-format=absolute --git-common-dir)" || exit 1
hook="$(basename "$0")"
native="$common/hooks/$hook"
if [ -x "$native" ] && [ "$native" != "$0" ]; then
  exec "$native" "$@"
fi
tracked="$root/.githooks/$hook"
if [ -x "$tracked" ]; then
  exec "$tracked" "$@"
fi
